# ==============================================================================
# SEC EDGAR Configuration
# Required by SEC fair-access policy: "SampleCompanyName AdminContact@<sample company domain>.com"
# ==============================================================================
SEC_USER_AGENT="DAGER-Research your.email@example.com"
SEC_MIN_INTERVAL_SECONDS=0.15

# ==============================================================================
# Database Configuration
# Defaults to local SQLite for development; switch to PostgreSQL URI in production.
# ==============================================================================
DATABASE_URL="sqlite:///./dager.db"

# ==============================================================================
# External Market & News API Keys (Optional)
# Used by news_client.py and market_client.py when premium providers are enabled.
# ==============================================================================
NEWS_API_KEY=""
FINNHUB_API_KEY=""

# ==============================================================================
# NLP / FinBERT Configuration
# Controls model selection and device placement for sentiment scoring.
# ==============================================================================
FINBERT_MODEL_NAME="ProsusAI/finbert"
SENTIMENT_DECAY_HALF_LIFE_DAYS=14.0

# ==============================================================================
# Cache & Evaluation Horizon Settings
# Controls TTLs (in hours) for pre-computed S&P 500 records vs. on-demand queries.
# ==============================================================================
SP500_CACHE_TTL_HOURS=24
ONDEMAND_CACHE_TTL_HOURS=12
LOG_LEVEL="INFO"

