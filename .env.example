# ==============================================================================
# SEC EDGAR Configuration
# Required by SEC fair-access policy: "SampleCompanyName AdminContact@<sample company domain>.com"
# ==============================================================================
SEC_USER_AGENT="DAGER-Research your.email@example.com"
SEC_MIN_INTERVAL_SECONDS=0.15

# ==============================================================================
# Database Configuration (Supabase PostgreSQL or Local SQLite)
# For Supabase: Project Settings -> Database -> Connection string -> URI (Session/Transaction pooler)
# Use a least-privilege role (not postgres superuser) with SSL enabled (`?sslmode=require`).
# Example: DATABASE_URL="postgresql://dager_web_app:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
# ==============================================================================
DATABASE_URL="sqlite:///./dager.db"
DB_REQUIRE_SSL=true

# ==============================================================================
# Prefect Cloud Configuration (Optional — for Cloud Dashboard & Scheduling)
# Found in Prefect Cloud -> Profile Settings -> API Keys & Workspace URL
# ==============================================================================
PREFECT_API_KEY=""
PREFECT_API_URL="https://api.prefect.cloud/api/accounts/[ACCOUNT-ID]/workspaces/[WORKSPACE-ID]"

# ==============================================================================
# External Market & News API Keys (Optional)
# Used by news_client.py and market_client.py when premium providers are enabled.
# ==============================================================================
NEWS_API_KEY=""
FINNHUB_API_KEY=""

# ==============================================================================
# NLP / FinBERT Configuration
# Controls model selection and device placement for sentiment scoring.
# ==============================================================================
FINBERT_MODEL_NAME="ProsusAI/finbert"
SENTIMENT_DECAY_HALF_LIFE_DAYS=14.0

# ==============================================================================
# Cache, Security & Authentication Settings
# Controls TTLs (in hours), Google OAuth Sign-In, session signing, and admin gating.
# ==============================================================================
SP500_CACHE_TTL_HOURS=24
ONDEMAND_CACHE_TTL_HOURS=1
LOG_LEVEL="INFO"
ENVIRONMENT="development"
GOOGLE_CLIENT_ID=""
AUTH_SECRET_KEY="replace-with-32-byte-random-hex-secret"
ADMIN_API_KEY=""

